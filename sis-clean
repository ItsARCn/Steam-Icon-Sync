#!/usr/bin/env bash

set -e

ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
STATE_DIR="$HOME/.local/share/steam-kde-icon-sync"
STATE_FILE="$STATE_DIR/managed"
APP_DIR="$HOME/.local/share/applications"

if [ ! -f "$STATE_FILE" ]; then
    echo "No icons managed by sis were found."
    exit 0
fi

cleaned=0
remaining="$STATE_DIR/managed.tmp"

: > "$remaining"

while IFS='|' read -r appid desktop original_icon; do
    [ -n "$appid" ] || continue
    [ -n "$desktop" ] || continue

    icon_name="steam_${appid}"
    icon_path="$ICON_DIR/$icon_name.png"

    if [ -f "$desktop" ] &&
       grep -q "steam://rungameid/$appid" "$desktop" &&
       grep -q "^Icon=$icon_name$" "$desktop"; then

        sed -i "s/^Icon=$icon_name$/Icon=$original_icon/" "$desktop"

        if [ -f "$icon_path" ]; then
            rm -f "$icon_path"
        fi

        game_name=$(grep '^Name=' "$desktop" | head -1 | cut -d= -f2-)

        printf '✓ Restored icon: %s\n' "$game_name"
        cleaned=$((cleaned + 1))
    else
        printf '%s|%s|%s\n' "$appid" "$desktop" "$original_icon" >> "$remaining"
    fi
done < "$STATE_FILE"

mv "$remaining" "$STATE_FILE"

if command -v kbuildsycoca6 >/dev/null 2>&1; then
    kbuildsycoca6 >/dev/null 2>&1
elif command -v kbuildsycoca5 >/dev/null 2>&1; then
    kbuildsycoca5 >/dev/null 2>&1
fi

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$APP_DIR" >/dev/null 2>&1
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1 || true
fi

if [ "$cleaned" -eq 0 ]; then
    echo "No icons created by sis needed cleaning."
else
    printf '\n✓ Done. Restored %d icon(s).\n' "$cleaned"
fi