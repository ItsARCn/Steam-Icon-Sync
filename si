#!/usr/bin/env bash

set -e

STEAM="$HOME/.local/share/Steam"
ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
APP_DIR="$HOME/.local/share/applications"
STATE_DIR="$HOME/.local/share/steam-kde-icon-sync"
STATE_FILE="$STATE_DIR/managed"

mkdir -p "$ICON_DIR" "$STATE_DIR"
touch "$STATE_FILE"

changed=0

refresh_desktop_database() {
    if command -v kbuildsycoca6 >/dev/null 2>&1; then
        kbuildsycoca6 >/dev/null 2>&1
    elif command -v kbuildsycoca5 >/dev/null 2>&1; then
        kbuildsycoca5 >/dev/null 2>&1
    fi

    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "$APP_DIR" >/dev/null 2>&1
    fi

    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1 || true
    fi
}

for cache in "$STEAM"/appcache/librarycache/*; do
    [ -d "$cache" ] || continue

    appid=$(basename "$cache")

    case "$appid" in
        ''|*[!0-9]*) continue ;;
    esac

    logo=$(find "$cache" -type f -name 'logo.png' -print -quit)
    [ -n "$logo" ] || continue

    icon_name="steam_${appid}"
    icon_path="$ICON_DIR/$icon_name.png"

    for desktop in "$APP_DIR"/*.desktop; do
        [ -f "$desktop" ] || continue

        if grep -q "steam://rungameid/$appid" "$desktop" &&
           grep -q '^Icon=steam$' "$desktop"; then

            game_name=$(grep '^Name=' "$desktop" | head -1 | cut -d= -f2-)

            if ! grep -Fq "|$desktop|" "$STATE_FILE"; then
                printf '%s|%s|%s\n' "$appid" "$desktop" "steam" >> "$STATE_FILE"
            fi

            cp -f "$logo" "$icon_path"
            sed -i "s/^Icon=steam$/Icon=$icon_name/" "$desktop"

            printf '✓ Changed icon: %s\n' "$game_name"
            changed=$((changed + 1))

            break
        fi
    done
done

refresh_desktop_database

if [ "$changed" -eq 0 ]; then
    echo "No icons needed updating."
else
    printf '\n✓ Done. Updated %d icon(s).\n' "$changed"
fi
